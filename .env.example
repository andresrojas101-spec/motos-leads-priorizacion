# Copiar a .env y completar. NUNCA commitear el .env real.

# Base de datos. Por defecto SQLite local; en produccion, Postgres/Supabase.
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres
DATABASE_URL=sqlite:///data/warehouse.db

# Fase 2 - proveedor de IA para extraccion desde conversaciones.
# "groq"      -> capa gratuita, sin tarjeta de credito. Crear la key en console.groq.com
# "anthropic" -> alternativa de pago, mayor calidad de extraccion si hay presupuesto.
PROVEEDOR_LLM=groq

GROQ_API_KEY=
# El catalogo de Groq cambia con frecuencia (ya nos paso en desarrollo: el modelo Llama
# que probamos primero fue retirado). Si MODELO_LLM da 404, correr esto para ver que hay
# disponible para tu propia key y ajustar aqui:
#   python -c "import groq,os; [print(m.id) for m in groq.Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"
# MODELO_LLM=openai/gpt-oss-20b

# Solo si PROVEEDOR_LLM=anthropic:
# ANTHROPIC_API_KEY=
# MODELO_LLM=claude-sonnet-5

# Cuantas conversaciones procesar en paralelo (Fase 2). El limite gratuito de Groq es por
# tokens/minuto A NIVEL DE CUENTA (verificado en piloto real: 8000 TPM para gpt-oss-20b,
# ~1200-1900 tokens por extraccion), no por conexion -- mas workers no acelera el batch,
# solo genera mas 429 que reintentar. 2 es un buen default; baja a 1 si ves muchos 429.
EXTRACCION_MAX_WORKERS=2
