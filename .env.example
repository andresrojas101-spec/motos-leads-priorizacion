# Copiar a .env y completar. NUNCA commitear el .env real.

# Base de datos. Por defecto SQLite local; en produccion, Postgres/Supabase.
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres
DATABASE_URL=sqlite:///data/warehouse.db

# Fase 2 - proveedor de IA para extraccion desde conversaciones.
# "groq"      -> capa gratuita, sin tarjeta de credito. Crear la key en console.groq.com
# "anthropic" -> alternativa de pago, mayor calidad de extraccion si hay presupuesto.
PROVEEDOR_LLM=groq

GROQ_API_KEY=
# Si el modelo de abajo ya no existe (el catalogo de Groq cambia), revisar los modelos
# vigentes en console.groq.com y ajustar aqui.
# MODELO_LLM=llama-3.3-70b-versatile

# Solo si PROVEEDOR_LLM=anthropic:
# ANTHROPIC_API_KEY=
# MODELO_LLM=claude-sonnet-5

# Cuantas conversaciones procesar en paralelo (Fase 2). Conservador por defecto para no
# chocar con el limite de peticiones por minuto de la capa gratuita de Groq.
EXTRACCION_MAX_WORKERS=4
