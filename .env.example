# Copiar a .env y completar. NUNCA commitear el .env real.

# Base de datos. Por defecto SQLite local; en produccion, Postgres/Supabase.
# Para probar contra Postgres real en local: `docker compose up -d` (ver
# docker-compose.yml) y despues:
# DATABASE_URL=postgresql+psycopg://motos:motos@localhost:5432/motos_leads
DATABASE_URL=sqlite:///data/warehouse.db

# Fase 2 - proveedor de IA para extraccion desde conversaciones.
# "ollama"    -> local, sin llave, sin costo, sin limite de tasa ni cuota diaria (el
#                unico techo es tu hardware). Requiere Ollama corriendo
#                (https://ollama.com) y el modelo descargado: `ollama pull llama3.1:8b`.
# "groq"      -> capa gratuita en la nube, sin tarjeta de credito, pero con cuota diaria
#                por modelo que puede agotarse en un batch largo (nos paso en pruebas).
# "anthropic" -> alternativa de pago, mayor calidad de extraccion si hay presupuesto.
PROVEEDOR_LLM=ollama

# Solo si PROVEEDOR_LLM=ollama (default):
OLLAMA_BASE_URL=http://localhost:11434/v1
MODELO_LLM=llama3.1:8b
# Verificado con una prueba real: llama3.1:8b sigue tool_choice forzado igual de bien
# que Groq, sin necesitar ningun ajuste de prompt adicional. Si tu maquina tiene mas
# RAM/GPU y quieres mejor calidad, qwen2.5:7b es otra opcion con buen soporte de
# tool-calling -- `ollama pull qwen2.5:7b` y ajustar MODELO_LLM aqui.

# Solo si PROVEEDOR_LLM=groq:
# GROQ_API_KEY=
# MODELO_LLM=openai/gpt-oss-120b
# La cuota diaria (TPD) de Groq es POR MODELO, no por cuenta: si uno se agota a mitad de
# un batch largo, cambiar aqui a otro (ej. openai/gpt-oss-20b) da presupuesto fresco.

# Solo si PROVEEDOR_LLM=anthropic:
# ANTHROPIC_API_KEY=
# MODELO_LLM=claude-sonnet-5

# Cuantas conversaciones procesar en paralelo (Fase 2). Con Ollama el techo real es el
# hardware local (un servidor sirviendo un modelo cargado en memoria procesa la mayoria
# de requests de forma efectivamente secuencial), asi que 1 es el default correcto salvo
# que confirmes que tu servidor paraleliza bien (GPU con VRAM de sobra). Con Groq, 2 fue
# el balance medido en piloto real (8000 TPM de tope -> ~5 peticiones/min sin importar
# cuantos workers corran).
EXTRACCION_MAX_WORKERS=1
