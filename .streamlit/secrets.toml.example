# Copiar a .streamlit/secrets.toml para correr el tablero local contra Supabase (opcional
# -- sin este archivo, tablero.py usa DATABASE_URL de .env/entorno, igual que el resto del
# pipeline). En Streamlit Cloud, este mismo valor se pega en la seccion "Secrets" del panel
# de la app -- NUNCA se commitea el secrets.toml real (ver .gitignore).

DATABASE_URL = "postgresql+psycopg://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"
